VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Storage bucket unused — files go to Cloudflare R2 via Worker.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_USE_FIREBASE_EMULATOR=false
# Must stay false in production — guest / anonymous use is not allowed.
# Set true only for offline local UI work without Firebase Auth.
VITE_DEMO_MODE=false
# Empty = same origin (/api on the Worker). Set only if API is on another host.
# Local: leave empty and run `bun run dev:api` (Vite proxies /api → :8787).
VITE_API_BASE_URL=
